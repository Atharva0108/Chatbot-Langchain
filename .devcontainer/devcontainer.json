// For format details, see https://aka.ms/devcontainer.json
{
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bullseye",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "Home.py"
      ]
    },
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "forwardPorts": [8501],
  "postCreateCommand": "pip install -r requirements.txt",
  "postAttachCommand": {
    "server": "streamlit run Home.py --server.enableCORS false --server.enableXsrfProtection false --server.port 8501"
  },
  "portsAttributes": {
    "8501": {
      "label": "Chatbot App",
      "onAutoForward": "openPreview"
    }
  },
  "remoteUser": "vscode"
}
